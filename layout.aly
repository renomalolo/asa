{
  ScrollView,
  layout_width="fill",
  layout_height="fill",
  {
    LinearLayout,
    orientation="vertical",
    layout_width="fill",
    padding="16dp",
    {
      Button,
      id="lokBtnKembaliAtas",
      text="KEMBALI KE MENU UTAMA",
      textColor="#FFFFFF",
      backgroundColor="#D32F2F",
      layout_width="fill",
      layout_marginBottom="12dp",
    },
    {
      TextView,
      text="Pilih provinsi atau wilayah:",
      textColor="#000000",
      textSize="15sp",
    },
    {
      Spinner,
      id="lokSpProvinsi",
      layout_width="fill",
      paddingTop="8dp",
      paddingBottom="8dp",
      contentDescription="Pilih provinsi atau wilayah",
    },
    {
      TextView,
      text="Pilih kota atau kabupaten:",
      textColor="#000000",
      textSize="15sp",
      layout_marginTop="12dp",
    },
    {
      Spinner,
      id="lokSpKota",
      layout_width="fill",
      paddingTop="8dp",
      paddingBottom="8dp",
      contentDescription="Pilih kota atau kabupaten",
    },
    {
      Button,
      id="lokBtnSimpan",
      text="SIMPAN DAN CARI JADWAL",
      textColor="#FFFFFF",
      backgroundColor="#4CAF50",
      layout_width="fill",
      layout_marginTop="16dp",
    },
    {
      Button,
      id="lokBtnKembaliBawah",
      text="KEMBALI KE MENU UTAMA",
      textColor="#FFFFFF",
      backgroundColor="#D32F2F",
      layout_width="fill",
      layout_marginTop="12dp",
    },
  },
}
